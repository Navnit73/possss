# Database Connection String
# Never commit a real connection string or credentials.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional email provider key
RESEND_API_KEY="re_replace_with_your_key"

# Razorpay subscriptions ($49/month Pro plan). Get keys at https://dashboard.razorpay.com/app/keys
# USD plans require "International payments" to be enabled on your Razorpay account.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-key-secret"
# Webhook URL: {APP_URL}/api/webhooks/razorpay — set the same secret there and enable the
# subscription.* events (authenticated, activated, charged, pending, halted, cancelled, completed, paused, resumed, updated)
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-secret"
# Optional: reuse an existing plan. If empty, the $49/month plan is created automatically on first use.
RAZORPAY_PLAN_ID=""

# Public application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXTAUTH_URL="http://localhost:3000"

NODE_ENV="development"
